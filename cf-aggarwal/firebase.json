{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": [
    {
      "target": "admin",
      "public": "hosting-admin",
      "cleanUrls": true,
      "trailingSlash": true,
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
    },
    {
      "target": "website",
      "public": "hosting-website",
      "cleanUrls": true,
      "trailingSlash": true,
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/menu/:category/:product",
          "destination": "/menu/item/index.html"
        },
        {
          "source": "/menu/:category",
          "destination": "/menu/cat/index.html"
        }
      ]
    }
  ],
  "functions": [
    {
      "source": ".",
      "codebase": "cf-aggarwal",
      "ignore": [
        "node_modules",
        ".git",
        ".firebase",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "scripts"
      ],
      "predeploy": [
        "npm run build"
      ]
    }
  ]
}
